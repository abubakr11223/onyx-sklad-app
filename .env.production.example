# Server'da: cp .env.production.example .env.production  — keyin haqiqiy qiymatlar bilan to'ldiring.
# .env.production HECH QACHON git'ga qo'shilmaydi (maxfiy). Bu shablon esa git'da qoladi.

# Domen. Caddy shu domenga Let's Encrypt HTTPS sertifikatini oladi.
# Domen hali yo'q bo'lsa — bo'sh qoldiring va Caddyfile'da IP-blokni (VARIANT B) yoqing.
DOMAIN=onyx.example.com
# ACME (Let's Encrypt) email — sertifikat ogohlantirishlari uchun.
ACME_EMAIL=you@example.com

# ── Postgres ──────────────────────────────────────────────────────
POSTGRES_USER=onyx
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=onyx

# DATABASE_URL host'i = db (Compose servis nomi), NE localhost.
# MUHIM: bu yerdagi parol POSTGRES_PASSWORD bilan AYNAN bir xil bo'lishi shart.
DATABASE_URL=postgresql://onyx:CHANGE_ME_strong_db_password@db:5432/onyx?schema=public

# ── Ilova auth (parol darvozasi) ──────────────────────────────────
# APP_PASSWORD — egaga/omborga kirish paroli (login sahifasi).
APP_PASSWORD=CHANGE_ME_owner_password
# AUTH_COOKIE_SECRET — cookie HMAC imzo kaliti. Yarating:  openssl rand -hex 32
AUTH_COOKIE_SECRET=CHANGE_ME_long_random_secret

# ── Telegram bot ──────────────────────────────────────────────────
# BUG-04: bu qiymatlarsiz fotozapros skladchiga YETIB BORMAYDI. Qo'shimcha shart —
# kamida bitta skladchi (WAREHOUSE) botga /start yuborib, kontaktini ulashib,
# telegramId'sini bog'lagan bo'lishi kerak (aks holda yuboradigan hech kim yo'q).
# TELEGRAM_BOT_TOKEN — @BotFather tokeni (MAJBURIY).
TELEGRAM_BOT_TOKEN=CHANGE_ME_bot_token
# TELEGRAM_WEBHOOK_SECRET — setWebhook'dagi maxfiy satr (MAJBURIY, webhook himoyasi).
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_webhook_secret
# APP_BASE_URL — havolalar bazasi (DOMAIN bilan mos), masalan https://onyx.example.com
APP_BASE_URL=https://onyx.example.com
# TELEGRAM_BOT_USERNAME — login sahifasidagi tugma uchun bot useri (@'siz).
TELEGRAM_BOT_USERNAME=CHANGE_ME_bot_username
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=CHANGE_ME_bot_username

# ── Rasm ombori ───────────────────────────────────────────────────
# PHOTO_STORAGE — rasmlar qayerda saqlanadi:
#   local        → o'z diskimiz (PHOTO_STORAGE_DIR papkasi, docker volume).
#                  EGA SERVERIDA SHU. Hech qanday tashqi xizmat kerak emas.
#   vercel-blob  → Vercel Blob (vaqtinchalik hosting davrida ishlatilgan).
# Berilmasa: BLOB_READ_WRITE_TOKEN bor bo'lsa vercel-blob, yo'q bo'lsa local.
#
# ⚠️ Ko'chirishda: ESKI rasmlar bazada to'liq URL (https://...blob...) bo'lib
# qoladi va o'sha manzildan ochilaveradi. Ular ham o'z serverga ko'chirilishi
# kerak bo'lsa — alohida ko'chirish skripti bilan (docs/migratsiya.md).
PHOTO_STORAGE=local
PHOTO_STORAGE_DIR=/data/photos

# ── Cron (muddati o'tgan bronlar + kunlik zaxira) ─────────────────
# CRON_SECRET — Vercel Cron endpoint himoyasi. Vercel Cron `/api/cron/
#   expire-reservations`ni chaqirganda `Authorization: Bearer <CRON_SECRET>`
#   yuboradi; mos kelmasa 401 (fail-closed). Vercel loyiha Settings →
#   Environment Variables'ga qo'ying. Jadval: vercel.json → kunlik 03:00 UTC
#   (Hobby reja cron'ni kuniga 1 marta cheklaydi; Pro'da tez-tez mumkin).
#   Yarating: openssl rand -hex 32
#
# Shu kalit KUNLIK ZAXIRA uchun ham ishlaydi: `/api/cron/backup` bazani
# JSON qilib yig'ib, Telegram orqali OWNER'larga yuboradi; `/api/export/
# snapshot` esa o'sha nusxani qaytaradi (tashqi saqlagichga olib ketish uchun).
# O'z serverida Vercel Cron yo'q. Jadval `docker-compose.prod.yml` ichidagi
# `cron` xizmatida — `up -d` qilinishi bilan o'zi ishlaydi, qo'lda crontab
# yozish SHART EMAS. Tekshirish:
#   docker compose -f docker-compose.prod.yml logs cron
#
# ⚠️ Host crontab'iga yozmang. Audit 2026-09-02 shuni aniqladi: cron o'z
# muhitida CRON_SECRET'ni bilmaydi, sarlavha bo'sh ketadi, server 401 beradi,
# natija esa /dev/null'ga yo'naladi — zaxira jimgina olinmay qoladi.
CRON_SECRET=CHANGE_ME_cron_secret

# EXPORT_SECRET — butun bazani yuklab olish uchun ALOHIDA kalit
# (`/api/export/snapshot`). Nega alohida: bu kalit qo'lda `curl` buyruqlarida
# ishlatiladi va terminal tarixida qoladi; cron kaliti bilan bitta bo'lsa,
# biri sizib chiqqanda ikkalasi ham ochiq qolardi.
# Berilmasa — CRON_SECRET ishlaydi (eski xatti-harakat, ko'chirishda sinmasin).
#   Yarating: openssl rand -hex 32
EXPORT_SECRET=CHANGE_ME_export_secret

# BACKUP_ENCRYPTION_KEY — kunlik zaxira faylini shifrlash kaliti.
#   BERILGAN bo'lsa:   fayl `.json.gz.enc`, ichida HAMMA narsa, shu jumladan
#                      parol xeshlari. Kalitsiz hech kim ocholmaydi.
#   BERILMAGAN bo'lsa: fayl `.json.gz`, parol xeshlari OLIB TASHLANADI
#                      (shifrlanmagan faylda ular Telegram'da yotmasin).
#                      Bunday zaxiradan tiklaganda parollarni qayta
#                      o'rnatish kerak: npm run seed:owner
#
# ⚠️ KALITNI YO'QOTMANG. Usiz eski shifrlangan zaxiralar ochilmaydi —
# ularni tiklashning boshqa yo'li yo'q. Nusxasini ilovadan TASHQARIDA
# saqlang (qog'ozda yoki parol menejerida).
#   Yarating: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=
