# Nusxa ko'chiring: cp .env.example .env
# docker-compose.yml dagi lokal Postgres bilan mos keladi.
DATABASE_URL="postgresql://onyx:onyx_dev@localhost:5432/onyx?schema=public"
# Migratsiya uchun to'g'ridan-to'g'ri ulanish. Lokalda DATABASE_URL bilan bir xil
# (pooler yo'q). Prod'da (Vercel+Neon) integratsiya buni avtomatik beradi.
DATABASE_URL_UNPOOLED="postgresql://onyx:onyx_dev@localhost:5432/onyx?schema=public"

# Umumiy parol darvozasi (Part 1 — auth).
# APP_PASSWORD — kirish paroli. AUTH_COOKIE_SECRET — cookie HMAC imzo kaliti
# (uzun tasodifiy satr, masalan: `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`).
APP_PASSWORD="change-me"
AUTH_COOKIE_SECRET="change-me-to-a-long-random-secret"

# Telegram bot (Sprint 2). BUG-04: bularsiz fotozapros skladchiga YETIB BORMAYDI.
# TELEGRAM_BOT_TOKEN — @BotFather'dan olingan token (bo'sh bo'lsa — hech qanday
#   xabar ketmaydi; sendMessage {ok:false,error:"no_token"} qaytaradi va loglaydi).
TELEGRAM_BOT_TOKEN=""
# TELEGRAM_WEBHOOK_SECRET — setWebhook'da beriladigan maxfiy satr (webhook'ni
#   himoyalaydi; bo'sh bo'lsa webhook update'lari RAD etiladi).
TELEGRAM_WEBHOOK_SECRET=""
# APP_BASE_URL — magic-link / «singan» havolalarining bazasi, masalan
#   `https://onyx.example`. Bo'sh bo'lsa bot havola o'rniga xato xabar yuboradi.
APP_BASE_URL=""
# TELEGRAM_BOT_USERNAME — login sahifasidagi «Открыть бота» tugmasi uchun bot
#   useri (@'siz, masalan `onyx_bot`). NEXT_PUBLIC_* — mijoz tomonda ham kerak
#   bo'lsa (ikkalasidan biri yetadi; server-only sozlama uchun NEXT_PUBLIC yo'q).
TELEGRAM_BOT_USERNAME=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

# Cron darvozasi (muddati o'tgan bronlarni avtomatik yopish — TZ §4.4/§6.6).
# CRON_SECRET — Vercel Cron `/api/cron/expire-reservations`ni chaqirganda
#   `Authorization: Bearer <CRON_SECRET>` sarlavhasida yuboradigan maxfiy satr.
#   Bo'sh bo'lsa endpoint 401 qaytaradi (fail-closed). Lokalda shart emas —
#   bron muddati /bron va /fotozapros render'idagi "lazy sweep"da ham yopiladi;
#   bu faqat prod'da hech kim sahifani ochmaganda backstop. Yarating:
#   `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
CRON_SECRET=""

# ─── AI funksiyalari ──────────────────────────────────────────────────────────
# Audit 2026-08-10: bular kodda ISHLATILADI, lekin shu paytgacha hech qayerda
# hujjatlashtirilmagan edi — natijada funksiyalar «sababsiz ishlamaydi» ko'rinardi.
# Ikkalasi ham fail-closed: kalit yo'q bo'lsa funksiya o'chadi, ilova yiqilmaydi.
#
# ANTHROPIC_API_KEY — «singan tosh» rasmidan shaklni aniqlash (src/lib/ai-shape.ts,
#   @anthropic-ai/sdk). Bo'sh bo'lsa shakl aniqlanmaydi (null), skladchik
#   o'lchamlarni qo'lda kiritadi.
ANTHROPIC_API_KEY=""
#
# AI-INTERYER (§6.7 «B», src/lib/interior-ai.ts) — BOSHQA yo'l: u Anthropic
#   kalitini EMAS, **Vercel AI Gateway**ni ishlatadi (`ai` paketi, model satri
#   `google/gemini-2.5-flash-image`). Vercel'da Gateway OIDC orqali o'zi ishlaydi;
#   lokalda `AI_GATEWAY_API_KEY` kerak bo'ladi.
AI_GATEWAY_API_KEY=""
# INTERIOR_AI_MODEL — modelni almashtirish (ixtiyoriy). Bo'sh bo'lsa yuqoridagi
#   default ishlatiladi.
INTERIOR_AI_MODEL=""

# ─── Rasm saqlash (Vercel Blob) ───────────────────────────────────────────────
# BLOB_READ_WRITE_TOKEN — @vercel/blob shu o'zgaruvchini O'ZI o'qiydi (koddan
#   nom bo'yicha chaqirilmaydi, shuning uchun grep bilan topilmaydi). Vercel'da
#   Blob integratsiyasi uni avtomatik qo'yadi; lokalda AI-interyer rasmlarini
#   saqlash uchun qo'lda kerak bo'ladi. Bo'sh bo'lsa Blob'ga yozish ishlamaydi.
BLOB_READ_WRITE_TOKEN=""

# ─── Faqat demo/seed uchun ────────────────────────────────────────────────────
# DEMO_WAREHOUSE_TELEGRAM_ID — demo-seed'dagi «skladchik»ning Telegram id'si.
#   PROD'DA BO'SH QOLDIRING: to'ldirilsa demo foydalanuvchi haqiqiy chat'ni
#   egallab olishi mumkin (avval shu sabab xato bo'lgan — commit 4f2bd78).
DEMO_WAREHOUSE_TELEGRAM_ID=""
