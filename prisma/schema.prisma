// Onyx — domen sxemasi (S1-C).
// Normativ spetsifikatsiya: docs/data-model.md (S1-B) + ADR-001…006.
// Muhim: Prisma ifodalay olmaydigan cheklovlar (partial unique indexlar,
// CHECK constraintlar) migratsiya SQL'ida qo'lda qo'shilgan —
// prisma/migrations/*_domain_model/migration.sql ga qarang.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

/// data-model.md §2 — Slab/Piece uchun umumiy status (Batch statusi hisoblanadi, ADR-005).
enum UnitStatus {
  AVAILABLE // В наличии
  RESERVED // Забронирован
  SOLD // Продан
  BROKEN_OFFCUT // Бой / остаток (faqat Slab uchun terminal)
  RETURNED // Возврат
}

/// data-model.md §1.5.
enum PieceKind {
  BROKEN // бой
  OFFCUT // остаток / обрезок
}

/// data-model.md §1.6 + ADR-006 (BATCH_VOLUME).
enum ReservationTarget {
  SLAB
  PIECE
  BATCH_VOLUME
}

enum ReservationStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

/// data-model.md §1.7 / TZ §3.
enum Role {
  OWNER
  MANAGER
  WAREHOUSE
  PARTNER
}

/// data-model.md §1.8 — IN_PROGRESS ataylab YO'Q (TZ §9).
enum PhotoRequestStatus {
  PENDING
  DONE
  CANCELLED
}

/// data-model.md §1.9.
enum PhotoKind {
  SLAB
  PIECE
  SAMPLE // vid namunasi
  INTERIOR_AI // QR-kartochka interyerlari (TZ §6.7)
  DRAWING // boy chertyoji
}

/// data-model.md §1.10.
enum AuditAction {
  INTAKE
  SALE
  RESERVE
  RESERVE_CANCEL
  RESERVE_EXPIRE
  SEPARATE_SLAB
  BREAK
  SPLIT
  MOVE
  PHOTO_REQUEST
  PHOTO_UPLOAD
  RETURN
  ADJUSTMENT
  STATUS_CHANGE
}

/// data-model.md §1.12 / ADR-006.
enum SaleTarget {
  SLAB
  PIECE
  BATCH_VOLUME
}

// ──────────────────────── Modellar ────────────────────────

/// §1.1 — Вид (sort) камня. Katalog darajasi (L1).
model StoneType {
  id             String   @id @default(cuid())
  name           String   @unique
  rockType       String // porода — S1 da string, enum emas (yangi porodalar joyida qo'shiladi)
  color          String?
  description    String?
  properties     Json?
  basePrice      Decimal? @db.Decimal(12, 2)
  purchasePrice  Decimal? @db.Decimal(12, 2) // FAQAT Owner + ruxsatli Manager
  textureFileUrl String?
  qrSlug         String   @unique
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  batches Batch[]
  slabs   Slab[]
  pieces  Piece[]
  photos  Photo[]

  @@index([rockType])
  @@index([color])
}

/// §1.2 — Партия. Asosiy hisob birligi (L2). Status va erkin qoldiq SAQLANMAYDI (ADR-005).
/// CHECK (SQL): slabsTotal va areaTotalM2 dan kamida bittasi NOT NULL.
model Batch {
  id               String   @id @default(cuid())
  stoneTypeId      String
  arrivedAt        DateTime
  supplierNote     String?
  slabsTotal       Int?
  areaTotalM2      Decimal? @db.Decimal(12, 3)
  slabsSoldDirect  Int      @default(0)
  areaSoldDirectM2 Decimal  @default(0) @db.Decimal(12, 3)
  slabsAdjusted    Int      @default(0)
  areaAdjustedM2   Decimal  @default(0) @db.Decimal(12, 3)
  purchasePrice    Decimal? @db.Decimal(12, 2)
  needsCheck       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  stoneType     StoneType       @relation(fields: [stoneTypeId], references: [id], onDelete: Restrict)
  locations     BatchLocation[]
  slabs         Slab[]
  pieces        Piece[]
  reservations  Reservation[]
  photoRequests PhotoRequest[]
  sales         SaleRecord[]

  @@index([stoneTypeId])
  @@index([arrivedAt])
  @@index([stoneTypeId, needsCheck])
}

/// §1.3 — partiya lokatsiyasi. Bitta partiya bir nechta joyda — NORMA (TZ §4.5).
/// (batchId, block, landmark) bo'yicha unique ATAYLAB yo'q.
model BatchLocation {
  id         String   @id @default(cuid())
  batchId    String
  block      String // «А», «Б», «В»…
  landmark   String // «2» yoki «1–2» — erkin format
  slabsHere  Int?
  areaHereM2 Decimal? @db.Decimal(12, 3)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  batch         Batch          @relation(fields: [batchId], references: [id], onDelete: Restrict)
  photoRequests PhotoRequest[]

  @@index([batchId])
  @@index([block, landmark])
}

/// §1.4 — Плита (L3). Yozuv faqat ajratish paytida tug'iladi (ADR-004).
model Slab {
  id              String     @id @default(cuid())
  batchId         String
  stoneTypeId     String // denormalizatsiya — «vid + status» qidiruvi bitta indexdan
  label           String // «Плита №2»
  status          UnitStatus @default(AVAILABLE)
  lengthMm        Int?
  widthMm         Int?
  thicknessMm     Int?
  areaM2          Decimal?   @db.Decimal(12, 3)
  isAreaEstimated Boolean    @default(true)
  block           String
  landmark        String
  needsCheck      Boolean    @default(false)
  photoRequestId  String? // qaysi fotozapros natijasida ajratilgan
  separatedById   String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  batch           Batch          @relation(fields: [batchId], references: [id], onDelete: Restrict)
  stoneType       StoneType      @relation(fields: [stoneTypeId], references: [id], onDelete: Restrict)
  photoRequest    PhotoRequest?  @relation("SlabSeparatedByRequest", fields: [photoRequestId], references: [id])
  separatedBy     User           @relation("SlabSeparatedBy", fields: [separatedById], references: [id], onDelete: Restrict)
  photos          Photo[]
  reservations    Reservation[]
  pieces          Piece[] // bo'linganda chiqqan qoldiqlar
  sales           SaleRecord[]
  reshootRequests PhotoRequest[] @relation("PhotoRequestReshootSlab")

  @@unique([batchId, label])
  @@index([stoneTypeId, status])
  @@index([batchId])
  @@index([block, landmark])
}

/// §1.5 — Бой / остаток / обрезок. Har doim poshtuchno, o'z gabaritlari bilan.
model Piece {
  id               String     @id @default(cuid())
  stoneTypeId      String
  batchId          String? // «uyesiz» boy uchun null
  originSlabId     String? // konkret plitadan chiqqan bo'lsa (hisob: §3 — formulada QATNASHMAYDI)
  kind             PieceKind
  status           UnitStatus @default(AVAILABLE)
  sidesMm          Json // har tomon uzunligi, mm: [1180, 640, 950, 610]
  boundingLengthMm Int // qidiruv shu bounding maydonlar bo'yicha
  boundingWidthMm  Int
  thicknessMm      Int?
  areaM2           Decimal?   @db.Decimal(12, 3)
  drawingUrl       String? // AI-chertyoj (TZ §5.5), S1 da bo'sh turadi
  block            String
  landmark         String
  needsCheck       Boolean    @default(false)
  createdById      String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  stoneType    StoneType     @relation(fields: [stoneTypeId], references: [id], onDelete: Restrict)
  batch        Batch?        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  originSlab   Slab?         @relation(fields: [originSlabId], references: [id], onDelete: Restrict)
  createdBy    User          @relation("PieceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  photos       Photo[]
  reservations Reservation[]
  sales        SaleRecord[]

  @@index([stoneTypeId, status])
  @@index([status, boundingLengthMm, boundingWidthMm])
  @@index([batchId])
  @@index([block, landmark])
}

/// §1.6 — Бронь (ADR-003, ADR-006).
/// SQL darajasida: partial unique (slabId / pieceId WHERE status='ACTIVE') +
/// CHECK: targetType ga mos FK to'ldirilgan, qolganlari null.
model Reservation {
  id              String            @id @default(cuid())
  targetType      ReservationTarget
  slabId          String?
  pieceId         String?
  batchId         String? // BATCH_VOLUME uchun
  qtySlabs        Int? // faqat BATCH_VOLUME
  qtyAreaM2       Decimal?          @db.Decimal(12, 3) // faqat BATCH_VOLUME
  managerId       String
  customerName    String // majburiy — «на всякий случай» brondan himoya
  customerContact String?
  expiresAt       DateTime // now + AppConfig.reservationDays (default 3 kun)
  status          ReservationStatus @default(ACTIVE)
  resolvedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  slab    Slab?  @relation(fields: [slabId], references: [id], onDelete: Restrict)
  piece   Piece? @relation(fields: [pieceId], references: [id], onDelete: Restrict)
  batch   Batch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  manager User   @relation("ReservationManager", fields: [managerId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt]) // cron: muddati o'tgan bronlar
  @@index([managerId, status]) // «kim nimani muzlatgan»
}

/// §1.7 — foydalanuvchi, 4 rol. Auth mexanikasi keyingi sprint; model ikkala kirishga tayyor.
model User {
  id                  String   @id @default(cuid())
  name                String
  role                Role
  phone               String?  @unique
  telegramId          String?  @unique
  email               String?  @unique
  passwordHash        String?
  canSeePurchasePrice Boolean  @default(false) // Owner uchun e'tiborga olinmaydi (doim ko'radi)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  reservations          Reservation[]  @relation("ReservationManager")
  slabsSeparated        Slab[]         @relation("SlabSeparatedBy")
  piecesCreated         Piece[]        @relation("PieceCreatedBy")
  photoRequestsCreated  PhotoRequest[] @relation("PhotoRequestManager")
  photoRequestsAssigned PhotoRequest[] @relation("PhotoRequestAssignee")
  photosTaken           Photo[]
  auditLogs             AuditLog[]
  sales                 SaleRecord[]
}

/// §1.8 — fotozapros (Telegram vazifasi). IN_PROGRESS statusi ataylab yo'q.
model PhotoRequest {
  id              String             @id @default(cuid())
  managerId       String
  assigneeId      String? // null = umumiy navbat
  batchId         String
  batchLocationId String?
  slabId          String? // mavjud plitani QAYTA suratga olish
  comment         String?
  status          PhotoRequestStatus @default(PENDING)
  completedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  manager        User           @relation("PhotoRequestManager", fields: [managerId], references: [id], onDelete: Restrict)
  assignee       User?          @relation("PhotoRequestAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  batch          Batch          @relation(fields: [batchId], references: [id], onDelete: Restrict)
  batchLocation  BatchLocation? @relation(fields: [batchLocationId], references: [id], onDelete: Restrict)
  slab           Slab?          @relation("PhotoRequestReshootSlab", fields: [slabId], references: [id], onDelete: Restrict)
  photos         Photo[]
  separatedSlabs Slab[]         @relation("SlabSeparatedByRequest")

  @@index([status, createdAt]) // navbat + rahbar paneli
  @@index([assigneeId, status])
  @@index([managerId])
}

/// §1.9 — foto. Abadiy saqlanadi, DELETE yo'q.
/// CHECK (SQL): stoneTypeId / slabId / pieceId dan kamida bittasi NOT NULL.
model Photo {
  id             String    @id @default(cuid())
  storageKey     String
  kind           PhotoKind
  takenAt        DateTime
  takenById      String? // AI-generatsiya uchun null
  stoneTypeId    String?
  slabId         String?
  pieceId        String?
  photoRequestId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  takenBy      User?         @relation(fields: [takenById], references: [id], onDelete: Restrict)
  stoneType    StoneType?    @relation(fields: [stoneTypeId], references: [id], onDelete: Restrict)
  slab         Slab?         @relation(fields: [slabId], references: [id], onDelete: Restrict)
  piece        Piece?        @relation(fields: [pieceId], references: [id], onDelete: Restrict)
  photoRequest PhotoRequest? @relation(fields: [photoRequestId], references: [id], onDelete: Restrict)

  @@index([slabId])
  @@index([pieceId])
  @@index([stoneTypeId, kind])
}

/// §1.10 — harakatlar tarixi. Log yozuvi asosiy amal bilan BITTA tranzaksiyada.
model AuditLog {
  id         String      @id @default(cuid())
  userId     String? // NULL = tizim amali (masalan, cron RESERVE_EXPIRE)
  action     AuditAction
  entityType String // «Batch», «Slab», «Piece»…
  entityId   String
  payload    Json // ADJUSTMENT uchun delta MAJBURIY
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

/// §1.11 — kalit-qiymat sozlamalar (ADR-003). S1: reservationDays, photoStaleMonths.
model AppConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// §1.12 — sotuv yozuvi (ADR-006). Sotuv + SaleRecord + AuditLog — bitta tranzaksiyada.
/// CHECK (SQL): targetType ga mos FK to'ldirilgan (Reservation bilan bir xil naqsh).
model SaleRecord {
  id              String     @id @default(cuid())
  managerId       String
  customerName    String
  customerContact String?
  targetType      SaleTarget
  slabId          String?
  pieceId         String?
  batchId         String? // BATCH_VOLUME uchun
  qtySlabs        Int? // faqat BATCH_VOLUME
  qtyAreaM2       Decimal?   @db.Decimal(12, 3) // faqat BATCH_VOLUME
  price           Decimal?   @db.Decimal(12, 2)
  soldAt          DateTime
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  manager User   @relation(fields: [managerId], references: [id], onDelete: Restrict)
  slab    Slab?  @relation(fields: [slabId], references: [id], onDelete: Restrict)
  piece   Piece? @relation(fields: [pieceId], references: [id], onDelete: Restrict)
  batch   Batch? @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([managerId, soldAt])
  @@index([soldAt])
  @@index([batchId])
  @@index([slabId])
  @@index([pieceId])
}
