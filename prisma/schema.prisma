// Minimal sxema — faqat ulanish (S1-A). Domen modeli S1-C da qo'shiladi
// (docs/data-model.md spetsifikatsiyasi asosida).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// S1-C gacha vaqtinchalik turadigan texnik model: migratsiya pipeline'ini
// (docker compose → prisma migrate dev) nol'dan tekshirish uchun.
model HealthCheck {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
}
