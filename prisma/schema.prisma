// Onyx — domen sxemasi (S1-C).
// Normativ spetsifikatsiya: docs/data-model.md (S1-B) + ADR-001…006.
// Muhim: Prisma ifodalay olmaydigan cheklovlar (partial unique indexlar,
// CHECK constraintlar) migratsiya SQL'ida qo'lda qo'shilgan —
// prisma/migrations/*_domain_model/migration.sql ga qarang.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime (serverless funksiyalar) — pooled ulanish (Neon pgbouncer / lokal Postgres).
  url       = env("DATABASE_URL")
  // Migratsiya/introspeksiya — to'g'ridan-to'g'ri (pooler orqali migrate ishlamaydi).
  // Vercel+Neon integratsiyasi DATABASE_URL_UNPOOLED'ni avtomatik beradi; lokalda
  // .env'da u DATABASE_URL bilan bir xil (lokal Postgres'da pooler yo'q).
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ───────────────────────── Enums ─────────────────────────

/// data-model.md §2 — Slab/Piece uchun umumiy status (Batch statusi hisoblanadi, ADR-005).
enum UnitStatus {
  AVAILABLE // В наличии
  RESERVED // Забронирован
  SOLD // Продан
  BROKEN_OFFCUT // Бой / остаток (faqat Slab uchun terminal)
  RETURNED // Возврат
  SAMPLE // sample issued (TZ10)
  /// TZ №15 Slice 3 — on display stand; not free stock, not sold.
  SHOWROOM
}

/// data-model.md §1.5.
enum PieceKind {
  BROKEN // бой
  OFFCUT // остаток / обрезок
}

/// data-model.md §1.6 + ADR-006 (BATCH_VOLUME).
enum ReservationTarget {
  SLAB
  PIECE
  BATCH_VOLUME
}

enum ReservationStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

/// data-model.md §1.7 / TZ §3.
enum Role {
  OWNER
  MANAGER
  WAREHOUSE
  /// Согласовано 2026-08-12 — зав. складом: всё, что может складчик, плюс
  /// изменение количества партии. Отдельная роль, а не флаг: владелец должен
  /// видеть её в «Сотрудниках» и переключать.
  WAREHOUSE_LEAD
  PARTNER
}

/// data-model.md §1.8 — IN_PROGRESS ataylab YO'Q (TZ §9).
enum PhotoRequestStatus {
  PENDING
  DONE
  CANCELLED
}

/// BUG-04 — fotozapros Telegram yetkazilishi holati (per-skladchik).
/// SENT = yuborildi, FAILED = xato (lastError'da sabab). PENDING statusi yo'q:
/// yozuv faqat urinish bo'lgach yaratiladi (yozuv yo'q = hali yuborilmagan).
enum PhotoDispatchStatus {
  SENT
  FAILED
}

/// data-model.md §1.9.
enum PhotoKind {
  SLAB
  PIECE
  SAMPLE // vid namunasi
  INTERIOR_AI // QR-kartochka interyerlari (TZ §6.7)
  DRAWING // boy chertyoji
  /// ТЗ №16 B — общее фото партии при приёмке (как пришла: паллета, контейнер).
  /// Не заменяет фото узора: узор — конкретный рисунок для B2C, партия — вся
  /// поставка. Складское фото, в публичный allowlist /api/photo НЕ входит.
  BATCH
}

/// data-model.md §1.10.
enum AuditAction {
  INTAKE
  SALE
  RESERVE
  RESERVE_CANCEL
  RESERVE_EXPIRE
  SEPARATE_SLAB
  BREAK
  SPLIT
  MOVE
  PHOTO_REQUEST
  PHOTO_UPLOAD
  RETURN
  ADJUSTMENT
  STATUS_CHANGE
  SAMPLE_ISSUE
  SAMPLE_RETURN
  SAMPLE_SELL
  SAMPLE_EXTEND
  /// TZ №15 — warehouse confirmed a physical hand-over (shipment).
  SHIPMENT_CONFIRM
  /// TZ №15 Slice 3 — unit sent to / returned from showroom.
  SHOWROOM_SEND
  SHOWROOM_RETURN
}

/// data-model.md §1.12 / ADR-006.
enum SaleTarget {
  SLAB
  PIECE
  BATCH_VOLUME
}

/// TZ №15 Slice 1 — only SALE used; SAMPLE/SHOWROOM reserved for later slices.
enum ShipmentKind {
  SALE
  SAMPLE
  SHOWROOM
}

/// TZ №9 — способ оплаты в продаже (часть A).
enum PaymentMethod {
  CASH // наличные
  CARD // карта
  CREDIT // в долг → создаётся Debt
}

/// TZ №9 — валюта продажи / долга. UZS и USD НИКОГДА не суммируются.
enum Currency {
  UZS
  USD
}

/// TZ №9 — статус долга (одна продажа = один долг).
enum DebtStatus {
  ACTIVE
  REPAID
  CANCELLED
}

/// TZ №10+11 — тип клиента: частный (B2C) / компания (B2B).
enum ClientType {
  B2C // частный клиент
  B2B // компания / застройщик
}

/// TZ №10+11 — тип объекта/стройки.
enum SiteType {
  RESIDENTIAL // жилой
  COMMERCIAL // коммерческий
  OTHER // другое
}

/// TZ №10+11 — статус объекта.
enum SiteStatus {
  ACTIVE // активен
  COMPLETED // завершён
}

enum SampleStatus {
  ACTIVE
  RETURNED
  SOLD
}

/// A1 (TZ §6.8) — статус лида (заявки дизайнера/партнёра). Простой прямой поток:
/// NEW → CONTACTED → CLOSED. IN_PROGRESS ataylab yo'q (TZ §9, как у PhotoRequest).
enum LeadStatus {
  NEW // заявка принята, ждёт менеджера
  CONTACTED // менеджер связался
  CLOSED // обработана / закрыта
}

/// TZ §6.8.5 — explicit request vs passive interest (looked, no order).
enum LeadKind {
  REQUEST // «Запросить объём» form submit
  VIEW // PARTNER opened stone card (no order)
}

// ──────────────────────── Modellar ────────────────────────

/// §1.1 — Вид (sort) камня. Katalog darajasi (L1).
model StoneType {
  id             String   @id @default(cuid())
  name           String   @unique
  rockType       String // porода — S1 da string, enum emas (yangi porodalar joyida qo'shiladi)
  color          String?
  description    String?
  properties     Json?
  basePrice      Decimal? @db.Decimal(12, 2)
  purchasePrice  Decimal? @db.Decimal(12, 2) // FAQAT Owner + ruxsatli Manager
  textureFileUrl String?
  qrSlug         String   @unique
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  batches Batch[]
  slabs   Slab[]
  pieces  Piece[]
  photos  Photo[]
  leads   Lead[]

  @@index([rockType])
  @@index([color])
  // /poisk (page.tsx:96-104): `WHERE isArchived = false [AND name > :after]
  // ORDER BY name ASC LIMIT 31`. isArchived'da index YO'Q edi, `name @unique`
  // esa isArchived'ni filtrlay olmaydi → butun katalog skan + sort. Bu kompozit
  // kursorli sahifalashni to'g'ridan-to'g'ri indeksdan tartiblangan holda beradi.
  // Shu filtrni ishlatadigan boshqa sahifalar: prodazha:74, priemka:40, bron:147.
  // DIQQAT: `name`/`rockType`/`color` bo'yicha ILIKE '%q%' (poisk-search.ts:19-28)
  // uchun GIN pg_trgm indekslari bor — ular Prisma tilida ifodalanmaydi,
  // migratsiya SQL'ida qo'lda (yuqoridagi 1-5 qatordagi izohga qarang).
  @@index([isArchived, name])
}

/// §1.2 — Партия. Asosiy hisob birligi (L2). Status va erkin qoldiq SAQLANMAYDI (ADR-005).
/// CHECK (SQL): slabsTotal va areaTotalM2 dan kamida bittasi NOT NULL.
model Batch {
  id               String   @id @default(cuid())
  stoneTypeId      String
  arrivedAt        DateTime
  supplierNote     String?
  slabsTotal       Int?
  areaTotalM2      Decimal? @db.Decimal(12, 3)
  slabsSoldDirect  Int      @default(0)
  areaSoldDirectM2 Decimal  @default(0) @db.Decimal(12, 3)
  slabsAdjusted    Int      @default(0)
  areaAdjustedM2   Decimal  @default(0) @db.Decimal(12, 3)
  purchasePrice    Decimal? @db.Decimal(12, 2)
  /// ТЗ №12: габарит плиты партии, см (имя *Mm legacy). Обязательны при новой приёмке.
  lengthMm         Int?
  widthMm          Int?
  /// Толщина партии, см — если однородная; при узорах — в BatchPattern.
  /// Decimal(5,1): на складе есть 18 мм = 1,8 см (решение владельца 2026-08-10).
  thicknessMm      Decimal? @db.Decimal(5, 1)
  needsCheck       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  stoneType     StoneType       @relation(fields: [stoneTypeId], references: [id], onDelete: Restrict)
  locations     BatchLocation[]
  slabs         Slab[]
  pieces        Piece[]
  reservations  Reservation[]
  photoRequests PhotoRequest[]
  sales          SaleRecord[]
  samples        Sample[]
  patterns       BatchPattern[]
  shipmentLines  ShipmentLine[]
  photos         Photo[] // ТЗ №16 B — общее фото партии

  @@index([stoneTypeId])
  @@index([arrivedAt])
  @@index([stoneTypeId, needsCheck])
}

/// ТЗ №3 — узор-подгруппа партии: часть партии с одинаковым узором и толщиной.
/// Приёмка остаётся быстрой (фото 3–4 на партию, не на плиту): один ряд = один
/// узор со своими плитами/м² и фото. Сумма плит/м² по подгруппам сходится с
/// тоталом партии (проверка при сохранении — validators/intake.ts).
model BatchPattern {
  id          String   @id @default(cuid())
  batchId     String
  description String // «светлый с прожилками»
  /// ТЗ №12: толщина в см (имя *Mm legacy). Однородная партия — на Batch.
  /// Decimal(5,1): 18 мм = 1,8 см (решение владельца 2026-08-10, ТЗ №12).
  thicknessMm Decimal? @db.Decimal(5, 1)
  /// ТЗ №12: габарит плиты подгруппы, см (если размеры в партии разные).
  lengthMm    Int?
  widthMm     Int?
  slabsCount  Int // плиты в подгруппе (при приёмке)
  areaM2      Decimal  @db.Decimal(12, 3) // площадь подгруппы, м² (при приёмке)
  // ТЗ №3 фаза 4 — продано из подгруппы (как batch.slabsSoldDirect, но по узору).
  // Остаток узора = slabsCount − slabsSold / areaM2 − areaSoldM2. Продажа из узора
  // синхронно инкрементит И эти счётчики, И batch.slabsSoldDirect (единый остаток).
  slabsSold   Int      @default(0)
  areaSoldM2  Decimal  @default(0) @db.Decimal(12, 3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  batch         Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  photos        Photo[]
  photoRequests PhotoRequest[]
  sales         SaleRecord[]

  @@index([batchId])
}

/// §1.3 — partiya lokatsiyasi. Bitta partiya bir nechta joyda — NORMA (TZ §4.5).
/// (batchId, block, landmark) bo'yicha unique ATAYLAB yo'q.
model BatchLocation {
  id         String   @id @default(cuid())
  batchId    String
  block      String // «А», «Б», «В»…
  landmark   String // «2» yoki «1–2» — erkin format
  slabsHere  Int?
  areaHereM2 Decimal? @db.Decimal(12, 3)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  batch         Batch          @relation(fields: [batchId], references: [id], onDelete: Restrict)
  photoRequests PhotoRequest[]

  @@index([batchId])
  @@index([block, landmark])
}

/// §1.4 — Плита (L3). Yozuv faqat ajratish paytida tug'iladi (ADR-004).
model Slab {
  id              String     @id @default(cuid())
  batchId         String
  stoneTypeId     String // denormalizatsiya — «vid + status» qidiruvi bitta indexdan
  label           String // «Плита №2»
  status          UnitStatus @default(AVAILABLE)
  /// ТЗ №12: см (legacy name Mm)
  lengthMm        Int?
  widthMm         Int?
  /// Decimal(5,1): 18 мм = 1,8 см (решение владельца 2026-08-10, ТЗ №12).
  thicknessMm     Decimal? @db.Decimal(5, 1)
  areaM2          Decimal?   @db.Decimal(12, 3)
  isAreaEstimated Boolean    @default(true)
  block           String
  landmark        String
  needsCheck      Boolean    @default(false)
  photoRequestId  String? // qaysi fotozapros natijasida ajratilgan
  separatedById   String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  batch           Batch          @relation(fields: [batchId], references: [id], onDelete: Restrict)
  stoneType       StoneType      @relation(fields: [stoneTypeId], references: [id], onDelete: Restrict)
  photoRequest    PhotoRequest?  @relation("SlabSeparatedByRequest", fields: [photoRequestId], references: [id])
  separatedBy     User           @relation("SlabSeparatedBy", fields: [separatedById], references: [id], onDelete: Restrict)
  photos          Photo[]
  reservations    Reservation[]
  pieces          Piece[] // bo'linganda chiqqan qoldiqlar
  sales           SaleRecord[]
  samples         Sample[]
  shipmentLines   ShipmentLine[]
  reshootRequests PhotoRequest[] @relation("PhotoRequestReshootSlab")
  showroomPlacements ShowroomPlacement[]

  @@unique([batchId, label])
  @@index([batchId])
  @@index([block, landmark])
  // /poisk + poisk-query groupBy: `stoneTypeId IN (…) AND status='AVAILABLE'
  // AND needsCheck = false` (TZ §7.4). Btree left-prefix: (a,b,c) (a,b) ni
  // ham qamrab oladi — eski `Slab_stoneTypeId_status_idx` ortiqcha edi va
  // shu migratsiyada olib tashlandi (W2-C). Call-site'lar: poisk-query.ts
  // groupBy, bron/kamen/prodazha/q nested `slabs where status [+ needsCheck]`.
  @@index([stoneTypeId, status, needsCheck])
}

/// §1.5 — Бой / остаток / обрезок. Har doim poshtuchno, o'z gabaritlari bilan.
model Piece {
  id               String     @id @default(cuid())
  stoneTypeId      String
  batchId          String? // «uyesiz» boy uchun null
  originSlabId     String? // konkret plitadan chiqqan bo'lsa (hisob: §3 — formulada QATNASHMAYDI)
  kind             PieceKind
  status           UnitStatus @default(AVAILABLE)
  sidesMm          Json // ТЗ №12: стороны в см (legacy Mm): [118, 64, 95]
  boundingLengthMm Int // qidiruv shu bounding maydonlar bo'yicha
  boundingWidthMm  Int
  // W6-A2 — STORED generated: L×W (см² после ТЗ №12). /poisk §6.5 ranking key
  // (display bilan bir xil). Prisma GENERATED ALWAYS yozmaydi — dbgenerated
  // Client INSERT/UPDATE da maydonni yubormaydi; DB hisoblaydi.
  // DDL: prisma/migrations/20260731102837_piece_bounding_area/migration.sql
  boundingAreaMm2  Int        @default(dbgenerated("(\"boundingLengthMm\" * \"boundingWidthMm\")"))
  /// Decimal(5,1): 18 мм = 1,8 см (решение владельца 2026-08-10, ТЗ №12).
  thicknessMm      Decimal? @db.Decimal(5, 1)
  areaM2           Decimal?   @db.Decimal(12, 3)
  drawingUrl       String? // AI-chertyoj (TZ §5.5), S1 da bo'sh turadi
  block            String
  landmark         String
  needsCheck       Boolean    @default(false)
  createdById      String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  stoneType    StoneType     @relation(fields: [stoneTypeId], references: [id], onDelete: Restrict)
  batch        Batch?        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  originSlab   Slab?         @relation(fields: [originSlabId], references: [id], onDelete: Restrict)
  createdBy    User          @relation("PieceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  photos       Photo[]
  reservations Reservation[]
  showroomPlacements ShowroomPlacement[]
  sales         SaleRecord[]
  samples       Sample[]
  shipmentLines ShipmentLine[]

  @@index([status, boundingLengthMm, boundingWidthMm])
  @@index([batchId])
  @@index([block, landmark])
  // /poisk + poisk-query groupBy: Slab bilan bir xil — needsCheck indeksda.
  // Eski `Piece_stoneTypeId_status_idx` left-prefix sifatida ortiqcha — olib
  // tashlandi (W2-C). Nested call-site'lar: bron/kamen/prodazha/q `pieces where
  // status [+ needsCheck]` stoneTypeId FK orqali.
  @@index([stoneTypeId, status, needsCheck])
  // W6-A2 /poisk: ORDER BY boundingAreaMm2 ASC LIMIT 501, status='AVAILABLE'.
  // status tenglik + boundingArea tartibi — planner indeksdan LIMIT bilan chiqa oladi.
  @@index([status, boundingAreaMm2])
  // Legacy: areaM2 bo'yicha tartib (W6-A oldin /poisk shu yolg'on kalitdan foydalangan).
  // Boshqa call-site bo'lmasa ham saqlanadi — DROP alohida task.
  @@index([status, areaM2])
  // batch-remainders.ts:139-144 — `batchId IN (…) AND originSlabId IS NULL`
  // (§3 formulasi: plitadan chiqqan boy hisobga KIRMAYDI). Yolg'iz
  // `originSlabId` indeksi foydasiz bo'lardi (IS NULL past selektivlik —
  // to'g'ridan-to'g'ri boy ko'pchilik), shuning uchun batchId prefiks sifatida.
  // Xuddi shu shaklni ishlatadigan joylar: reservations.ts:339, breaking.ts:610,
  // breaking.ts:758, slab-separation.ts:73, sales.ts:682.
  @@index([batchId, originSlabId])
}

/// §1.6 — Бронь (ADR-003, ADR-006).
/// SQL darajasida: partial unique (slabId / pieceId WHERE status='ACTIVE') +
/// CHECK: targetType ga mos FK to'ldirilgan, qolganlari null.
model Reservation {
  id              String            @id @default(cuid())
  targetType      ReservationTarget
  slabId          String?
  pieceId         String?
  batchId         String? // BATCH_VOLUME uchun
  qtySlabs        Int? // faqat BATCH_VOLUME
  qtyAreaM2       Decimal?          @db.Decimal(12, 3) // faqat BATCH_VOLUME
  managerId       String
  customerName    String // majburiy — «на всякий случай» brondan himoya
  customerContact String?
  expiresAt       DateTime // now + AppConfig.reservationDays (default 3 kun)
  status          ReservationStatus @default(ACTIVE)
  resolvedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  slab    Slab?  @relation(fields: [slabId], references: [id], onDelete: Restrict)
  piece   Piece? @relation(fields: [pieceId], references: [id], onDelete: Restrict)
  batch   Batch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  manager User   @relation("ReservationManager", fields: [managerId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt]) // cron: muddati o'tgan bronlar
  @@index([managerId, status]) // «kim nimani muzlatgan»
  // batch-remainders.ts:233-241 (BUG-03 volume-hold): `status='ACTIVE' AND
  // targetType='BATCH_VOLUME' AND batchId IN (…) AND expiresAt > now()`.
  // Mavjud indekslarning HECH BIRIDA batchId yoki targetType yo'q. Ustunlar
  // tartibi: tenglik (status, targetType) → IN (batchId) → oraliq (expiresAt).
  @@index([status, targetType, batchId, expiresAt])
}

/// §1.7 — foydalanuvchi, 4 rol. Auth mexanikasi keyingi sprint; model ikkala kirishga tayyor.
model User {
  id                  String   @id @default(cuid())
  name                String
  role                Role
  phone               String?  @unique
  telegramId          String?  @unique
  email               String?  @unique
  passwordHash        String?
  // Аудит ТЗ №7 #9 — эпоха session-токена. Инкремент → все ранее выпущенные
  // session-токены пользователя становятся невалидными («log out everywhere»).
  // Апается на смене пароля (accounts/actions.ts) и в будущем — вручную владельцем.
  tokenVersion        Int      @default(0)
  canSeePurchasePrice Boolean  @default(false) // Owner uchun e'tiborga olinmaydi (doim ko'radi)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  reservations          Reservation[]  @relation("ReservationManager")
  slabsSeparated        Slab[]         @relation("SlabSeparatedBy")
  piecesCreated         Piece[]        @relation("PieceCreatedBy")
  photoRequestsCreated  PhotoRequest[] @relation("PhotoRequestManager")
  photoRequestsAssigned PhotoRequest[] @relation("PhotoRequestAssignee")
  photosTaken           Photo[]
  auditLogs             AuditLog[]
  sales                 SaleRecord[]
  leadsCreated          Lead[]         @relation("LeadCreatedBy")
  leadsAssigned         Lead[]         @relation("LeadAssignedManager")
  clientsCreated        Client[]       @relation("ClientManager")
  sitesCreated          Site[]         @relation("SiteManager")
  samplesIssued         Sample[]       @relation("SampleManager")
  shipmentsCreated      Shipment[]     @relation("ShipmentManager")
  showroomSends         ShowroomPlacement[] @relation("ShowroomSentBy")
}

/// §1.8 — fotozapros (Telegram vazifasi). IN_PROGRESS statusi ataylab yo'q.
model PhotoRequest {
  id              String             @id @default(cuid())
  managerId       String
  assigneeId      String? // null = umumiy navbat
  batchId         String
  batchLocationId String?
  batchPatternId  String? // ТЗ №3 — фото узор-подгруппы (не плиты)
  slabId          String? // mavjud plitani QAYTA suratga olish
  comment         String?
  status          PhotoRequestStatus @default(PENDING)
  completedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  manager        User           @relation("PhotoRequestManager", fields: [managerId], references: [id], onDelete: Restrict)
  assignee       User?          @relation("PhotoRequestAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  batch          Batch           @relation(fields: [batchId], references: [id], onDelete: Restrict)
  batchLocation  BatchLocation?  @relation(fields: [batchLocationId], references: [id], onDelete: Restrict)
  batchPattern   BatchPattern?   @relation(fields: [batchPatternId], references: [id], onDelete: Cascade)
  slab           Slab?           @relation("PhotoRequestReshootSlab", fields: [slabId], references: [id], onDelete: Restrict)
  photos         Photo[]
  separatedSlabs Slab[]          @relation("SlabSeparatedByRequest")
  dispatches     PhotoDispatch[]

  @@index([status, createdAt]) // navbat + rahbar paneli
  @@index([assigneeId, status])
  @@index([managerId])
  @@index([batchPatternId])
}

/// BUG-04 — Telegram yetkazilish yozuvi (per-skladchik, per-fotozapros). §8 История:
/// har urinish natijasi (SENT/FAILED, lastError, attempts) shu yerda ko'rinadi.
/// Bitta (fotozapros, chatId) juftligiga bitta yozuv — qayta urinish o'sha
/// yozuvni yangilaydi (upsert), attempts oshadi. Yozuv YO'Q = o'sha skladchiga
/// hali umuman yuborilmagan (masalan, u keyinroq ro'yxatdan o'tgan) →
/// redispatchPendingPhotoRequests uni tutib yuboradi.
model PhotoDispatch {
  id             String              @id @default(cuid())
  photoRequestId String
  chatId         String // skladchining telegramId'si (yuborilgan chat)
  status         PhotoDispatchStatus
  attempts       Int                 @default(0)
  lastError      String? // FAILED sababi (BUG-04 diagnostikasi uchun)
  deliveredAt    DateTime? // SENT bo'lgan payt
  messageId      Int? // §5.3 — yuborilgan vazifa xabarining Telegram message_id'si.
  //                    Skladchi shu xabarga reply qilib foto yuborsa, foto AYNAN
  //                    shu fotozaprosga bog'lanadi (FIFO'dan ustun). null = xabar
  //                    yuborilmagan yoki message_id qaytmagan.
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  photoRequest PhotoRequest @relation(fields: [photoRequestId], references: [id], onDelete: Cascade)

  @@unique([photoRequestId, chatId]) // bitta skladchiga bitta yozuv (upsert kaliti)
  @@index([status])
  @@index([photoRequestId])
  @@index([chatId, messageId]) // §5.3 — reply-to bo'yicha fotozaprosni topish
}

/// §1.9 — foto. Abadiy saqlanadi, DELETE yo'q.
/// CHECK (SQL): stoneTypeId / slabId / pieceId dan kamida bittasi NOT NULL.
model Photo {
  id             String    @id @default(cuid())
  storageKey     String
  kind           PhotoKind
  takenAt        DateTime
  takenById      String? // AI-generatsiya uchun null
  stoneTypeId    String?
  slabId         String?
  pieceId        String?
  photoRequestId String?
  batchPatternId String? // ТЗ №3 — фото узор-подгруппы
  /// ТЗ №16 B — фото партии целиком. ВНИМАНИЕ: любой новый «владелец» фото
  /// обязан попасть в CHECK `Photo_owner_check` — иначе INSERT падает уже в
  /// проде, а не в тестах. Ровно это случилось с batchPatternId (миграция
  /// 20260724102513): фото узора молча не сохранялось.
  batchId        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  takenBy      User?         @relation(fields: [takenById], references: [id], onDelete: Restrict)
  stoneType    StoneType?    @relation(fields: [stoneTypeId], references: [id], onDelete: Restrict)
  slab         Slab?         @relation(fields: [slabId], references: [id], onDelete: Restrict)
  piece        Piece?        @relation(fields: [pieceId], references: [id], onDelete: Restrict)
  photoRequest PhotoRequest? @relation(fields: [photoRequestId], references: [id], onDelete: Restrict)
  batchPattern BatchPattern? @relation(fields: [batchPatternId], references: [id], onDelete: Cascade)
  batch        Batch?        @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([slabId])
  @@index([pieceId])
  @@index([stoneTypeId, kind])
  @@index([batchPatternId])
  @@index([batchId])
}

/// §1.10 — harakatlar tarixi. Log yozuvi asosiy amal bilan BITTA tranzaksiyada.
model AuditLog {
  id         String      @id @default(cuid())
  userId     String? // NULL = tizim amali (masalan, cron RESERVE_EXPIRE)
  action     AuditAction
  entityType String // «Batch», «Slab», «Piece»…
  entityId   String
  payload    Json // ADJUSTMENT uchun delta MAJBURIY
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

/// Karta готовности проекта (/karta) holati — localStorage o'rniga Postgres.
/// Har bir yozuv bitta katakcha. done — bajarilgan/bajarilmagan bayrog'i.
model KartaCell {
  cellId    String   @id
  done      Boolean  @default(false)
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// §1.11 — kalit-qiymat sozlamalar (ADR-003). S1: reservationDays, photoStaleMonths.
model AppConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// TZ №10+11 §3 — справочник клиентов (частник / компания).
/// Старые SaleRecord остаются с текстовым customerName; clientId nullable.

/// TZ №10 — образец на руках у клиента.
///
/// ⚠️ PARTIAL UNIQUE INDEXES (не выражаются в Prisma schema — только SQL):
///   migration `20260804160000_tz10_sample`:
///     - sample_active_slab_uniq  ON ("slabId")  WHERE status='ACTIVE' AND slabId  IS NOT NULL
///     - sample_active_piece_uniq ON ("pieceId") WHERE status='ACTIVE' AND pieceId IS NOT NULL
///   `prisma db push` их НЕ создаст. Только `prisma migrate deploy`.
///   Без них возможна двойная выдача одной плиты двумя менеджерами.
///
model Sample {
  id                 String       @id @default(cuid())
  targetType         SaleTarget
  slabId             String?
  pieceId            String?
  batchId            String?
  qtySlabs           Int?
  qtyAreaM2          Decimal?     @db.Decimal(12, 3)
  clientId           String
  issuedAt           DateTime     @default(now())
  returnDueDate      DateTime
  depositAmount      Decimal?     @db.Decimal(14, 2)
  depositCurrency    Currency?
  depositReturnedAt  DateTime?
  comment            String?
  photoUrl           String?
  locationNote       String?
  managerId          String
  status             SampleStatus @default(ACTIVE)
  saleRecordId       String?      @unique
  linkedRequestId    String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  client     Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  manager    User        @relation("SampleManager", fields: [managerId], references: [id], onDelete: Restrict)
  slab       Slab?       @relation(fields: [slabId], references: [id], onDelete: Restrict)
  piece      Piece?      @relation(fields: [pieceId], references: [id], onDelete: Restrict)
  batch      Batch?      @relation(fields: [batchId], references: [id], onDelete: Restrict)
  saleRecord SaleRecord? @relation(fields: [saleRecordId], references: [id], onDelete: Restrict)
  /// TZ №15 Slice 2 — at most one shipment task per sample (1:1 sibling).
  shipment   Shipment?

  @@index([status, returnDueDate])
  @@index([clientId, status])
  @@index([managerId, status])
  @@index([slabId, status])
  @@index([pieceId, status])
  @@index([batchId, status])
}

model Client {
  id            String     @id @default(cuid())
  name          String // ФИО или название компании
  type          ClientType
  phone         String // обязателен; дубли мягко ловятся в коде (этап 2)
  extraContacts String? // доп. контакты (свободный текст)
  comment       String?
  /// Кто завёл карточку (владелец/менеджер). Скоуп «менеджер — свои».
  managerId     String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  manager    User         @relation("ClientManager", fields: [managerId], references: [id], onDelete: Restrict)
  sites      Site[]
  sales      SaleRecord[]
  debts      Debt[]
  samples    Sample[]
  shipments  Shipment[]

  @@index([managerId, createdAt])
  @@index([phone])
  @@index([type, name])
  @@index([name])
}

/// TZ №10+11 §3 — объект / стройка. Привязан к клиенту-заказчику.
model Site {
  id            String     @id @default(cuid())
  name          String // «ЖК Ривьера», «Дом Ахмедова»
  type          SiteType
  address       String?
  clientId      String // заказчик / застройщик
  status        SiteStatus @default(ACTIVE)
  comment       String?
  /// Контакт на объекте (прораб/снабженец) — отдельно от заказчика.
  contactPerson String?
  /// Кто завёл объект. Скоуп «менеджер — свои».
  managerId     String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  client    Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  manager   User         @relation("SiteManager", fields: [managerId], references: [id], onDelete: Restrict)
  sales     SaleRecord[]
  shipments Shipment[]

  @@index([clientId, status])
  @@index([managerId, createdAt])
  @@index([status, name])
  @@index([name])
}

/// §1.12 — sotuv yozuvi (ADR-006). Sotuv + SaleRecord + AuditLog — bitta tranzaksiyada.
/// CHECK (SQL): targetType ga mos FK to'ldirilgan (Reservation bilan bir xil naqsh).
/// TZ №9: paymentMethod / currency / price — DB'da nullable (eski qatorlar),
/// yangi sotuvda validator majburiy qiladi. CREDIT → Debt bir xil tx'da.
model SaleRecord {
  id              String         @id @default(cuid())
  managerId       String
  customerName    String
  customerContact String?
  targetType      SaleTarget
  slabId          String?
  pieceId         String?
  batchId         String? // BATCH_VOLUME uchun
  batchPatternId  String? // ТЗ №3 — продажа из узор-подгруппы (BATCH_VOLUME + узор)
  qtySlabs        Int? // faqat BATCH_VOLUME
  qtyAreaM2       Decimal?       @db.Decimal(12, 3) // faqat BATCH_VOLUME
  /// TZ №9: total sale amount (not per-m²). Decimal(14,2) — see result-1
  /// «Decimal precision decision»: UZS B2B totals can exceed Decimal(12,2).
  /// MUST match Debt.amount scale.
  price           Decimal?       @db.Decimal(14, 2)
  /// TZ №9 — способ оплаты. null = legacy row (до модуля долгов).
  paymentMethod   PaymentMethod?
  /// TZ №9 — валюта цены/долга. null = legacy.
  currency        Currency?
  soldAt          DateTime
  /// TZ §4.3 — «Возврат от клиента». null = продажа активна; заполнено =
  /// продажа отменена возвратом (идемпотентность: повторный возврат запрещён).
  returnedAt      DateTime?
  /// TZ №10+11 — справочник клиентов. null = legacy row (текстовый customerName).
  /// Новые продажи: validator сделает clientId обязательным (этап 2).
  clientId        String?
  /// TZ №10+11 — объект/стройка. null = частная продажа без объекта или legacy.
  siteId          String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  manager      User          @relation(fields: [managerId], references: [id], onDelete: Restrict)
  slab         Slab?         @relation(fields: [slabId], references: [id], onDelete: Restrict)
  piece        Piece?        @relation(fields: [pieceId], references: [id], onDelete: Restrict)
  batch        Batch?        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  batchPattern BatchPattern? @relation(fields: [batchPatternId], references: [id], onDelete: Restrict)
  client       Client?       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  site         Site?         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  debt         Debt?
  sampleFrom   Sample?
  /// TZ №15 — at most one shipment task per sale (1:1).
  shipment     Shipment?

  @@index([managerId, soldAt])
  @@index([soldAt])
  @@index([batchId])
  @@index([slabId])
  @@index([pieceId])
  @@index([batchPatternId])
  @@index([paymentMethod, soldAt])
  @@index([clientId, soldAt])
  @@index([siteId, soldAt])
}

/// TZ №15 — warehouse hand-over task (SALE + SAMPLE in slice 2; SHOWROOM later).
/// Status OPEN/PARTIAL/DONE is DERIVED from line qty shipped vs ordered (+ cancelledAt).
/// Stock write-off stays on the commercial TX — confirm does NOT change UnitStatus / Sample.
model Shipment {
  id           String       @id @default(cuid())
  kind         ShipmentKind @default(SALE)
  /// Required for SALE; unique → one shipment per sale.
  saleRecordId String?      @unique
  /// Required for SAMPLE; unique → one shipment per sample (sibling, not second Sample).
  sampleId     String?      @unique
  managerId    String
  clientId     String?
  siteId       String?
  note         String?
  /// ТЗ №15 §8.5 — «приоритет/срочность задачи»: клиент ждёт, складчик берёт
  /// эту задачу первой. Обычный флаг, а не отдельный статус: срочность не
  /// меняет жизненный цикл отгрузки, только порядок в очереди.
  isUrgent     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  /// Set when every line is fully shipped (derived DONE).
  completedAt  DateTime?
  /// Sale/sample returned before any/full ship — task cancelled.
  cancelledAt  DateTime?
  updatedAt    DateTime     @updatedAt

  saleRecord SaleRecord?    @relation(fields: [saleRecordId], references: [id], onDelete: Restrict)
  sample     Sample?        @relation(fields: [sampleId], references: [id], onDelete: Restrict)
  manager    User           @relation("ShipmentManager", fields: [managerId], references: [id], onDelete: Restrict)
  client     Client?        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  site       Site?          @relation(fields: [siteId], references: [id], onDelete: Restrict)
  lines      ShipmentLine[]
  /// TZ15 Slice 3 — optional reverse link from SHOWROOM shipment to placement.
  showroomPlacement ShowroomPlacement?

  @@index([cancelledAt, completedAt, createdAt])
  @@index([managerId, createdAt])
  @@index([kind, createdAt])
}

/// TZ №15 Slice 3 — metadata for a unit currently (or historically) on a display stand.
/// Source of truth for «in showroom now» is UnitStatus.SHOWROOM; this row carries
/// stand note / who / when. closedAt set on return / sell / sample from showroom.
model ShowroomPlacement {
  id          String     @id @default(cuid())
  targetType  SaleTarget // SLAB | PIECE only
  slabId      String?
  pieceId     String?
  /// Which stand / display comment (manager or warehouse free text).
  standNote   String?
  sentById    String
  sentAt      DateTime   @default(now())
  closedAt    DateTime?
  /// Sibling SHOWROOM shipment (physical move task); optional after confirm archive.
  shipmentId  String?    @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  slab     Slab?     @relation(fields: [slabId], references: [id], onDelete: Restrict)
  piece    Piece?    @relation(fields: [pieceId], references: [id], onDelete: Restrict)
  sentBy   User      @relation("ShowroomSentBy", fields: [sentById], references: [id], onDelete: Restrict)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@index([closedAt, sentAt])
  @@index([slabId, closedAt])
  @@index([pieceId, closedAt])
  @@index([sentById, sentAt])
}

/// Ordered vs shipped quantities — source of truth for derived shipment status.
model ShipmentLine {
  id                 String     @id @default(cuid())
  shipmentId         String
  targetType         SaleTarget
  slabId             String?
  pieceId            String?
  batchId            String?
  qtyOrderedSlabs    Int?
  qtyOrderedAreaM2   Decimal?   @db.Decimal(12, 3)
  qtyShippedSlabs    Int        @default(0)
  qtyShippedAreaM2   Decimal    @default(0) @db.Decimal(12, 3)
  /// block/landmark snapshot at sale (warehouse speed).
  locationSnapshot   String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  slab     Slab?    @relation(fields: [slabId], references: [id], onDelete: Restrict)
  piece    Piece?   @relation(fields: [pieceId], references: [id], onDelete: Restrict)
  batch    Batch?   @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([shipmentId])
  @@index([slabId])
  @@index([pieceId])
  @@index([batchId])
}

/// TZ №9 — долг по продаже «в долг». 1 SaleRecord = 0..1 Debt (CREDIT only).
/// Клиент/камень/менеджер НЕ дублируются — читаются из SaleRecord (§7).
/// amount Decimal(14,2) — SAME as SaleRecord.price (copy of total sale amount).
/// Catalog unit prices (StoneType.basePrice) stay Decimal(12,2); this is a total.
/// dueDate: end of Asia/Tashkent calendar day (see debts.normalizeDebtDueDate).
model Debt {
  id            String     @id @default(cuid())
  saleRecordId  String     @unique
  amount        Decimal    @db.Decimal(14, 2)
  currency      Currency
  status        DebtStatus @default(ACTIVE)
  dueDate       DateTime?
  comment       String?
  repaidAt      DateTime?
  /// Reserved for future partial repayment (§6). Full repay sets = amount.
  repaidAmount  Decimal?   @db.Decimal(14, 2)
  /// TZ №10+11 — denormalized link for client card debts. null = legacy / no Client.
  /// Source of truth for customer text remains SaleRecord; this speeds client-card queries.
  clientId      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  saleRecord SaleRecord @relation(fields: [saleRecordId], references: [id], onDelete: Restrict)
  client     Client?    @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([status, dueDate])
  @@index([status, createdAt])
  @@index([currency, status])
  @@index([clientId, status])
}

/// A1 (TZ §6.8) — Лид: входящий интерес дизайнера/партнёра. Партнёр смотрит
/// камень, запрашивает объём → КАЖДЫЙ запрос становится Lead(NEW) и попадает к
/// менеджеру («ни один интерес не теряется», §6.8.5). Это НЕ бронь и НЕ продажа
/// (те требуют единиц/менеджера) — а сырой запрос, который менеджер обрабатывает
/// вручную. requestedSlabs/requestedAreaM2 — что просил партнёр (оба опциональны:
/// интерес может быть без точного объёма). assignedManager — кто взял заявку.
model Lead {
  id                String     @id @default(cuid())
  createdById       String // партнёр/дизайнер, создавший запрос
  stoneTypeId       String? // интересующий вид (может быть null)
  /// W8-A: REQUEST = explicit form; VIEW = passive open of stone card (§6.8.5).
  kind              LeadKind   @default(REQUEST)
  requestedSlabs    Int?
  requestedAreaM2   Decimal?   @db.Decimal(12, 3)
  contact           String? // контакт партнёра/его клиента (свободный текст)
  note              String?
  status            LeadStatus @default(NEW)
  assignedManagerId String? // менеджер, взявший заявку в работу
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  createdBy       User       @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  stoneType       StoneType? @relation(fields: [stoneTypeId], references: [id], onDelete: Restrict)
  assignedManager User?      @relation("LeadAssignedManager", fields: [assignedManagerId], references: [id], onDelete: Restrict)

  @@index([status, createdAt]) // очередь менеджера: новые сверху
  @@index([createdById])
  @@index([assignedManagerId])
  // Passive-view dedupe lookup: partner + stone + kind + open status.
  @@index([createdById, stoneTypeId, kind, status])
}

// §5.9 / onboarding — заявка на доступ через Telegram. Новый человек нажимает
// /start и делится контактом; если телефон не привязан ни к какому аккаунту —
// создаётся заявка (PENDING). Владелец в /accounts одобряет (выбирает роль →
// создаётся User с telegramId+phone+role) или отклоняет. Доступ НИКОГДА не даётся
// автоматически — только владелец решает (защита от самопривязки к складу).
model TelegramAccessRequest {
  id         String   @id @default(cuid())
  telegramId String   @unique // Telegram chat/user id (строка, как User.telegramId)
  name       String? // из contact.first_name + last_name
  username   String? // @username, если есть
  phone      String? // нормализованный из shared-контакта
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
}

// ТЗ №6 — сетка склада (блоки + ориентиры), НЕЗАВИСИМАЯ от камня. Стратегия
// внедрения (основное ТЗ §10): сначала разметить склад (блоки/флаги), потом
// заносить камень. Пустой размеченный блок — норма. Локации приёмки
// (BatchLocation) ссылаются на эти блоки/ориентиры по letter/number (единый
// справочник). Редактирует ТОЛЬКО Владелец.
// Аудит ТЗ №7 #10 — истраченные magic-link jti. Row-level UNIQUE @id — атомарный
// «один раз» без внешнего KV: create → P2002 у второй попытки. expiresAt = exp
// самого токена (2 мин); индекс — только для sweep'а pruneExpiredMagicJti.
model ConsumedMagicLinkToken {
  jti       String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// W7-A2 — idempotent client mutation receipts (Slice 1: INTAKE).
/// mutationId (UUID) @id: first commit creates domain row + receipt; replay
/// finds receipt and returns the same entityId (no second Batch).
/// Concurrent race: second tx creates Batch then receipt INSERT P2002 →
/// throw → whole $transaction rolls back orphan Batch; caller redirects to
/// winner's entityId. No expiresAt / no prune — late replay after prune
/// would double-create stock; intake volume is low.
model MutationReceipt {
  mutationId  String   @id
  kind        String // «INTAKE» (sale/reserve intentionally out of scope)
  userId      String?
  entityType  String // «Batch»
  entityId    String
  resultJson  Json? // e.g. { stoneName, patternIds } for redirect without re-query
  createdAt   DateTime @default(now())

  @@index([kind, createdAt])
  @@index([userId, createdAt])
}

/// W9-D / TG-C-next — Telegram webhook update_id at-most-once.
/// PK = String(update_id). First delivery INSERT; replay → P2002 → skip
/// handleUpdate domain work (no second Photo / separateSlab / access request).
/// expiresAt + lazy prune (7d) — unlike MutationReceipt, webhook volume needs TTL.
model TelegramWebhookReceipt {
  updateId  String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Аудит 2026-08-10 — счётчик НЕУДАЧНЫХ входов (/login, email+пароль).
/// Раньше пароль можно было подбирать бесконечно: единственным тормозом была
/// стоимость самого PBKDF2 (100k итераций) — то есть каждая попытка ещё и жгла
/// CPU функции, что делало перебор одновременно и способом положить сайт.
///
/// Две области (`scope`):
///  • «email» — защищает конкретный аккаунт от подбора пароля;
///  • «ip»    — защищает от распыления (spraying) по многим аккаунтам с одного адреса.
/// Порог у «ip» намеренно выше: за одним NAT может сидеть весь склад.
///
/// Окно скользит: первая неудача ставит firstAt; по истечении окна счётчик
/// начинается заново. Успешный вход удаляет строку (сотрудник, вспомнивший
/// пароль, не должен ждать). Ключи чистятся ленивой prune (как webhook receipt).
model LoginAttempt {
  scope    String // «email» | «ip»
  key      String // нормализованный email или адрес
  failures Int      @default(0)
  firstAt  DateTime @default(now())
  lastAt   DateTime @default(now())

  @@id([scope, key])
  @@index([lastAt])
}

model WarehouseBlock {
  id        String   @id @default(cuid())
  letter    String   @unique // «А», «Б», «В»… — буква блока, уникальна
  areaM2    Decimal? @db.Decimal(12, 3) // примерная площадь (необязательно)
  note      String? // «у ворот», «плохой заезд», «крыша течёт»
  isFull    Boolean  @default(false) // false = есть место, true = заполнен
  sortOrder Int      @default(0) // порядок на экране (не строго по алфавиту)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  landmarks WarehouseLandmark[]

  @@index([sortOrder])
}

model WarehouseLandmark {
  id      String @id @default(cuid())
  blockId String
  number  String // «1», «2»… (строка — допускает «1–2»); уникален в блоке

  block WarehouseBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([blockId, number])
  @@index([blockId])
}
